# Rendered to /etc/nginx/conf.d/default.conf at container start (envsubst on $PORT).
server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Compression
    gzip               on;
    gzip_vary          on;
    gzip_min_length    1024;
    gzip_proxied       any;
    gzip_comp_level    6;
    gzip_types         text/plain text/css application/json application/javascript text/xml
                       application/xml application/xml+rss text/javascript application/wasm
                       image/svg+xml text/markdown;

    # Health endpoint for Cloud Run / k8s probes
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Long-cache static assets (JS/CSS/fonts)
    location ~* ^/site/assets/.+\.(js|css)$ {
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        try_files $uri =404;
    }

    # Markdown notes — short cache, immutable in deploy
    location ~* \.md$ {
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Type "text/markdown; charset=utf-8" always;
        try_files $uri =404;
    }

    # Default
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
}
